{
  "name": "vite-t3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run lint && vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "npm run build && wrangler deploy",
    "dev": "node --watch --watch-path=src/server --watch-path=src/locales --watch-path=public/openapi --watch-path=.env --watch-path=package.json --import tsx src/server/app.ts",
    "docker:build": "docker build --build-arg NODE_VERSION=$npm_package_engines_node -t vite-t3:latest .",
    "docker:down": "docker-compose down",
    "docker:up": "NODE_VERSION=$npm_package_engines_node docker-compose up -d --build",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "npm run build && node scripts/preview.js",
    "start": "node dist/server/app.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "1.6.2",
    "@libsql/client": "0.18.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "antd": "6.6.2",
    "argon2": "0.45.1",
    "chalk": "6.0.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "^4.13.5",
    "i18next": "26.4.1",
    "i18next-browser-languagedetector": "8.2.1",
    "quicktype-core": "26.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-head": "3.4.2",
    "react-i18next": "17.0.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "engines": {
    "node": "24.20.0"
  }
}
