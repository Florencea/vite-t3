{
  "name": "vite-t3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run lint && vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "node --watch --watch-path=src/server --watch-path=src/locales --watch-path=public/openapi --watch-path=.env --watch-path=package.json --import tsx src/server/app.ts",
    "format": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "npm run build && node scripts/preview.js",
    "start": "node dist/server/app.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@paralleldrive/cuid2": "3.3.0",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-router": "1.170.32",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "antd": "6.6.1",
    "argon2": "0.45.1",
    "body-parser": "2.3.0",
    "chalk": "6.0.0",
    "clsx": "2.1.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "i18next": "26.4.0",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-middleware": "3.9.8",
    "iron-session": "8.0.4",
    "quicktype-core": "26.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-head": "3.4.2",
    "react-i18next": "17.0.12",
    "swagger-ui-express": "5.0.1",
    "trpc-to-openapi": "3.3.0",
    "vite-express": "0.22.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@types/body-parser": "1.19.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/swagger-ui-express": "4.1.8",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  },
  "engines": {
    "node": "24.20.0"
  }
}
