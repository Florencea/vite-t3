# Client and Server shared config
VITE_TITLE="Test Vite T3"
VITE_WEB_BASE="/"
VITE_API_OPENAPI_DOC_ROUTE="/openapi"
VITE_API_ENDPOINT_RPC="/api"
VITE_OUTDIR="dist"

# Feature flags (1 = enable, 0 = disable)
ENABLE_CLIENT=1
ENABLE_SERVER=1
ENABLE_OPENAPI=1
ENABLE_TYPEGEN=1
ENABLE_COMPRESSION=1
TRUST_PROXY=1

# Server & deployment options
DEPLOY_TARGET="node" # "node" | "docker" | "cloudflare" | "auto"
PORT=3000
CORS_ORIGIN="*"

# Database & session security
DATABASE_DRIVER="auto" # "sqlite" | "d1" | "libsql" | "auto"
DATABASE_URL="file:./database.sqlite"
COOKIE_NAME="TestViteT3"
COOKIE_SECRET="a long secret at least 32 characters long"
SESSION_TTL=604800 # 7 days in seconds
